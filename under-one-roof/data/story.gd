# ------------------------------------------------------------------ helpers
static func speaker_name(id: String) -> String:
	return NAMES.get(id, "")


static func portrait_of(id: String) -> String:
	if id in ["", "voice"]:
		return ""
	if id.begins_with("worker"):
		return "worker"
	return id


static func voice_pitch(id: String) -> float:
	return VOICE.get(id, 1.0) - 1.0


static func idle_line(id: String) -> String:
	return "..."


static func label_for(iid: String) -> String:
	if LABELS.has(iid):
		return LABELS[iid]
	if iid.begins_with("herb_"):
		return "اقطف الأعشاب"
	if iid.begins_with("coin_") or iid.begins_with("shell_"):
		return "التقط"
	if iid.begins_with("collect_") or iid == "lost_compass":
		return "افحص الشيء اللامع"
	if iid.begins_with("door_") or iid.begins_with("exit_"):
		return "ادخل"
	if iid.begins_with("paint_"):
		return "تأمّل المنظر"
	return "افحص"
