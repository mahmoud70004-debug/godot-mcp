class_name SpriteSheetData
extends Resource
## Pre-rendered pixel-art character sheet (generated by tools/pixelize_sprites.py).
##
## v2 (indexed, trimmed; see .router/PLAN.md C10): `texture` is an L8 index atlas, `palette` a
## 256 x variants RGBA texture, `frames` holds 6 ints per frame (atlas x, y, w, h, box x, box y).
## Animation frame index = anims[name].start + dir * frames + f.
## v1 (legacy grid, RGBA texture, no palette): `frames` is empty and anims carry a "row";
## the cell of direction d, frame f is (f * frame_size.x, (row + d) * frame_size.y).

@export var texture: Texture2D
## v2 only: 256 x variants RGBA palette texture (row v = variant v).
@export var palette: Texture2D
## v2 only: number of palette rows.
@export var variants := 1
## Untrimmed box in pixels shared by all frames.
@export var frame_size := Vector2i(64, 80)
## v2 only: 6 ints per frame: atlas x, y, w, h, then x/y of the trimmed rect's top-left inside the box.
@export var frames := PackedInt32Array()
## Direction 0 faces the camera (front), then clockwise every 360/directions degrees.
@export var directions := 8
## v2: name -> {"start": int, "frames": int, "fps": float, "loop": bool}
## v1: name -> {"row": int, "frames": int, "fps": float, "loop": bool}
@export var anims: Dictionary = {}
## Metres per sprite pixel.
@export var pixel_size := 0.028
## Box rows below the feet (transparent pixels).
@export var foot_offset_px := 2


## Direction index shared with the offline baker (see .router/PLAN.md, Direction convention).
## local_to_camera: camera position minus sprite position, in the sprite's local space.
static func direction_index(local_to_camera: Vector3, dirs: int) -> int:
	var phi := atan2(local_to_camera.x, local_to_camera.z)
	return posmod(roundi((-phi - PI) / (TAU / dirs)), dirs)


## True for indexed/trimmed sheets, false for legacy grid sheets.
func is_v2() -> bool:
	return not frames.is_empty()


## v2: index into `frames` of frame `f` of direction `dir` for the anim described by `info`.
func frame_index(info: Dictionary, dir: int, f: int) -> int:
	return int(info["start"]) + dir * int(info["frames"]) + f


## v2: rectangle of frame `idx` inside the atlas.
func frame_rect(idx: int) -> Rect2i:
	var b := idx * 6
	return Rect2i(frames[b], frames[b + 1], frames[b + 2], frames[b + 3])


## v2: top-left of frame `idx`'s trimmed rect inside the untrimmed box.
func frame_box_pos(idx: int) -> Vector2i:
	var b := idx * 6
	return Vector2i(frames[b + 4], frames[b + 5])


## v2: Sprite3D.offset (pixels, +y up, sprite centred) that puts the trimmed rect where it sits in the
## box, with the box's horizontal centre on the node origin and the feet (box bottom - foot_offset_px) at y = 0.
func frame_sprite_offset(idx: int) -> Vector2:
	var r := frame_rect(idx)
	var p := frame_box_pos(idx)
	return Vector2(
		p.x + r.size.x * 0.5 - frame_size.x * 0.5,
		frame_size.y - foot_offset_px - p.y - r.size.y * 0.5
	)
