class_name SpriteSheetData
extends Resource
## Pre-rendered pixel-art character sheet (generated by tools/pixelize_sprites.py).
## Sheet layout: row = anims[name].row + dir ; column = frame index.

@export var texture: Texture2D
## Pixels per frame.
@export var frame_size := Vector2i(64, 80)
## Direction 0 faces the camera (front), then clockwise every 360/directions degrees.
@export var directions := 8
## name -> {"row": int, "frames": int, "fps": float, "loop": bool}
@export var anims: Dictionary = {}
## Metres per sprite pixel.
@export var pixel_size := 0.028
## Transparent pixels below the feet.
@export var foot_offset_px := 2


## Direction index shared with the offline baker (see .router/PLAN.md, Direction convention).
## local_to_camera: camera position minus sprite position, in the sprite's local space.
static func direction_index(local_to_camera: Vector3, dirs: int) -> int:
	var phi := atan2(local_to_camera.x, local_to_camera.z)
	return posmod(roundi((-phi - PI) / (TAU / dirs)), dirs)
