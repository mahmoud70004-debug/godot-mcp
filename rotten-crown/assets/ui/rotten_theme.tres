[gd_resource type="Theme" load_steps=21 format=3]

; Rotten Crown UI theme (U14 design pass).
; Palette (ART_DIRECTION, Moonlit Meadows): ground #0e110f, surface #181c19, raised #232823,
; active #2e342e, ink #dcd5bf (bone), muted #9a9d8b, faint #6c7064,
; accent #a9c04e (the green window of the Royal Keep: focus and the one action), blood #9e2419.
; Type: Jersey 10 (text, 19 px = one font pixel per screen pixel at 640x360) and
; Jacquard 24 (display, 43 px = 1:1, 86 px = 2:1). Both OFL, see assets/fonts/.
; Antialiasing is off in the font import settings, so glyphs stay pixel-crisp.

[ext_resource type="FontFile" uid="uid://c8gma25v0y3yo" path="res://assets/fonts/Jersey10-Regular.ttf" id="1_text"]
[ext_resource type="FontFile" uid="uid://bitv711rdxs67" path="res://assets/fonts/Jacquard24-Regular.ttf" id="2_display"]

