[gd_resource type="Resource" script_class="DialogueSequence" load_steps=7 format=3]

[ext_resource type="Script" path="res://src/dialogue/dialogue_sequence.gd" id="1_seq"]
[ext_resource type="Script" path="res://src/dialogue/dialogue_line.gd" id="2_line"]

[sub_resource type="Resource" id="Line_1"]
script = ExtResource("2_line")
text = "...My head. What happened?"
hold = 2.2

[sub_resource type="Resource" id="Line_2"]
script = ExtResource("2_line")
text = "Where is everyone?"
